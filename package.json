{
  "name": "{{APP_NAME}}",
  "displayName": "{{APP_TITLE}}",
  "version": "1.0.0",
  "description": "{{APP_TITLE}} - Next.js Web Application",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/{{GITHUB_ORG}}/{{APP_NAME}}.git"
  },
  "browserslist": {
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ],
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ]
  },
  "dependencies": {
    "@chakra-ui/react": "^3.36.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@futurehax/nextjs-common": "^0.2.0",
    "@futurehax/nextjs-common-ui": "^0.2.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "pg": "^8.16.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-icons": "^5.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/cz-commitlint": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@futurehax/commons-doctor": "^0.1.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "26.1.1",
    "@types/pg": "^8.15.5",
    "@types/react": "19.2.17",
    "@typescript-eslint/eslint-plugin": "8.64.0",
    "@typescript-eslint/parser": "8.64.0",
    "autoprefixer": "^10.5.2",
    "dotenv": "^17.4.2",
    "eslint": "10.7.0",
    "eslint-config-next": "16.2.10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "prisma": "^7.8.0",
    "prisma-field-encryption": "^1.6.0",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.7",
    "semantic-release-helm3": "^2.10.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "prettier": "./.shared-tooling/prettier/base.json",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:format": "prettier '**/*.(js|jsx|ts|tsx|json|yaml|yml|md|css|scss|less)' --write && next lint --fix",
    "clean": "rimraf .next out node_modules",
    "type-check": "tsc --noEmit --pretty",
    "prepare": "husky",
    "release": "semantic-release",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,md,json,css,scss}": [
      "prettier --write"
    ],
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  }
}
